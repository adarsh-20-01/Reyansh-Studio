# ========================================================
# REYANSH STUDIO - BACKEND ENVIRONMENT CONFIGURATION
# ========================================================

# Server Port
PORT=5000
FLASK_ENV=development

# 1. Business Destination Email (where customer inquiries will be received)
BUSINESS_EMAIL=reyaneshstudio@gmail.com

# 2. SMTP Server Configuration
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=your-email@gmail.com
#   SMTP_PASSWORD=your_16_char_google_app_password
#   SMTP_FROM_EMAIL=your-email@gmail.com
#
# For Outlook / Office 365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#
# For Custom Domain / cPanel / Webmail / Hostinger:
#   SMTP_HOST=smtp.yourdomain.com
#   SMTP_PORT=465 or 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=reyaneshstudio@gmail.com
SMTP_PASSWORD=djrq tlxl mbis pujp
SMTP_FROM_EMAIL=reyaneshstudio@gmail.com

# Also compatible with legacy keys:
# RECEIVER_EMAIL=reyaneshstudio@gmail.com
# EMAIL_USER=reyaneshstudio@gmail.com
# EMAIL_PASS=your_16_char_google_app_password

# 3. Security & Spam Protection
# Comma-separated list of allowed origins (* for any in local development)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173

# Rate limit: Maximum inquiries allowed per client IP within a 10-minute window
RATE_LIMIT_PER_WINDOW=5
RATE_LIMIT_WINDOW_SECONDS=600

# 4. Admin Portal Authentication
ADMIN_EMAIL=reyaneshstudio@gmail.com
ADMIN_PASSWORD=reyansh@2026
