# ========================================================
# REYANSH STUDIO - BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real values locally.
# Never commit real API keys, SMTP passwords, or tokens.
# ========================================================

# Server Port
PORT=5000
FLASK_ENV=development

# 1. Business Destination Email (where customer inquiries will be received)
BUSINESS_EMAIL=reyaneshstudio@gmail.com
RECEIVER_EMAIL=reyaneshstudio@gmail.com

# 2. Resend HTTPS Transactional Email (Node/Express backend — server.js)
# Get your free API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Sender email: Use onboarding@resend.dev for instant testing,
# or your verified domain e.g. enquiry@reyanshstudio.com
VERIFIED_SENDER_EMAIL=onboarding@resend.dev
SENDER_EMAIL=onboarding@resend.dev

# 3. SMTP Email (Python Flask backend — app.py)
# Use a Gmail App Password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=your_smtp_username
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_app_password

# 4. AI automatic customer acknowledgements (optional)
# If these are empty, customers still receive the predefined fallback reply
# after the studio notification email is accepted by the email provider.
# Compatible with OpenAI and other OpenAI-compatible chat completion APIs.
AI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# 5. Security & Spam Protection
# Comma-separated list of allowed origins (* for any in local development)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173

# Rate limit: Maximum inquiries allowed per client IP within a 10-minute window
RATE_LIMIT_PER_WINDOW=5
RATE_LIMIT_WINDOW_SECONDS=600

# 6. Admin Portal Authentication
ADMIN_EMAIL=reyaneshstudio@gmail.com
ADMIN_PASSWORD=change_this_admin_password
