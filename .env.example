# ========================================================
# REYANSH STUDIO - BACKEND ENVIRONMENT CONFIGURATION
# ========================================================

# Server Port
PORT=5000
FLASK_ENV=development

# 1. Business Destination Email (where customer inquiries will be received)
BUSINESS_EMAIL=reyaneshstudio@gmail.com
RECEIVER_EMAIL=reyaneshstudio@gmail.com

# 2. Resend HTTPS Transactional Email Configuration (Works on Render Free tier via Port 443)
# Get your free API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Sender email: Use onboarding@resend.dev for instant testing,
# or your verified domain e.g. enquiry@reyanshstudio.com
VERIFIED_SENDER_EMAIL=onboarding@resend.dev

# 3. Security & Spam Protection
# Comma-separated list of allowed origins (* for any in local development)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173

# Rate limit: Maximum inquiries allowed per client IP within a 10-minute window
RATE_LIMIT_PER_WINDOW=5
RATE_LIMIT_WINDOW_SECONDS=600

# 4. Admin Portal Authentication
ADMIN_EMAIL=reyaneshstudio@gmail.com
ADMIN_PASSWORD=reyansh@2026
