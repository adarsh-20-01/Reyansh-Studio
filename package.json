{
  "name": "reyansh-interiors",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -n \"FLASK,CLIENT\" -c \"blue,magenta\" \"python app.py\" \"vite\"",
    "dev:node": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"node server.js\" \"vite\"",
