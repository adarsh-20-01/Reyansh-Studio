    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "react": "^19.1.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.1.0",
    "react-intersection-observer": "^10.0.3",
    "react-router-dom": "^7.15.0",
    "swiper": "^12.1.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "vite": "^6.3.5"
